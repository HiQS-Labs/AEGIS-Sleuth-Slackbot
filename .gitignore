# Our Custom Settings
.vs
.vscode/settings.json
data/runtime/
data/logs/
*.log
newrelic_agent.log
.env
.env.*
!.env.example
data/static/ai/*.backup
src/.restart-trigger.json
xyz-tick/
.xyz/
relay-system/preflight/
.codebase-memory/
