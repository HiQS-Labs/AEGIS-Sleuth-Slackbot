# Host-level configuration for AEGIS (copy to .env — never commit .env).
# Workspace secrets (Slack tokens, AI keys) are NOT stored here; register them via the Web API.
#
# Step-by-step setup: docs/getting-started.md
# Full API reference: docs/web-api.md

# --- Required for admin panel (encrypts SMTP credentials at rest) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ENCRYPTION_KEY=

# --- Web API (host process) ---
# Bearer token for POST /workspace and other REST endpoints. If unset, dev fallback is "test".
WEB_API_BEARER_TOKEN=
# Port for the Web API (default 2020).
WEB_API_PORT=2020

# --- Optional monitoring ---
# New Relic is off unless this is set. There is no fallback key.
# NEW_RELIC_LICENSE_KEY=

# --- Optional feature flags (uncomment when needed) ---
# REMINDER_TEXT_SYNTHESIS=on
# GOOGLE_API_KEY=
# SLEUTH_RAG_GITHUB_PAT=
# SNAPSHOT_RELAY_WORKSPACES=
# SNAPSHOT_RELAY_REPO=
# ROUTER_SHADOW_WORKSPACES=

# --- HiQS progress digest relay (GH-157) ---
# A second SnapshotRelayModule instance. rebalance-OS pushes one digest per slot into
# <repo>/<dir> at 13:05 and 17:05 PT; this relays each new file to Slack.
#
# BOTH of the next two are required — the relay stays disabled unless the workspace is
# allowlisted AND a channel id is set. That is deliberate: a digest in the wrong channel is
# worse than no digest.
#
# HIQS_DIGEST_CHANNEL_ID has NO in-repo default. The module's fallback is a sanitized
# placeholder, and a real Slack channel id is flagged HIGH by utils/sanitize-scan.sh — it must
# live here on the box, never in git.
# HIQS_DIGEST_WORKSPACES=
# HIQS_DIGEST_CHANNEL_ID=
#
# Optional. Default to the SNAPSHOT_RELAY_* repo/branch — only the watched directory differs.
# HIQS_DIGEST_REPO=
# HIQS_DIGEST_BRANCH=
# HIQS_DIGEST_DIR=digests

# --- Bug reporting (:bug: reaction, send-to-github) ---
# Target repo (owner/name) for user-filed bug reports. Deliberately NO default: a hardcoded repo
# would file every deployment's user reports into someone else's tracker. Unset, the filer replies
# that bug reporting is not configured instead of 404ing against repos//issues (GH-89).
# SLEUTH_ISSUE_REPO=HiQS-Labs/AEGIS-Sleuth-Slackbot

# Deterministic "Did you mean the `X` command?" suggestion when a message scores as a near-miss
# against the command catalog (no LLM call). Suggest-only, never auto-runs. OFF unless armed.
# COMMAND_NEAR_MISS_LITE=on
# Escalates near-misses the deterministic tier above declines (score present but below its floor,
# with a clear top candidate) to the existing RMM resolver for a confidence-tiered suggestion.
# Suggest-only, never auto-runs. OFF unless armed. See COMMAND_NEAR_MISS_LITE.
# COMMAND_NEAR_MISS_LLM=on

# --- Decision corpus capture (GH-50) ---
# Records every AI decision (input, model output, debug facts) to
# data/runtime/decisions/<workspace>_decisions.jsonl for offline replay.
# OFF unless armed. Records contain RAW MESSAGE TEXT — this is tenant data, not
# telemetry — so arming it is an operator decision with a retention obligation.
# DECISION_CAPTURE_ENABLED=on
# Optional: restrict collection to named workspaces (comma-separated). Unset = all.
# DECISION_CAPTURE_WORKSPACES=

# --- Channel antecedent lookback (GH-55) ---
# Lets a TOP-LEVEL channel message resolve a pronoun ("get it done by Monday") from an earlier
# message, instead of scheduling the literal sentence and losing both the task and its owner.
# In-thread resolution needs no flag and is always on; this covers the no-thread case only.
#
# OFF unless armed, and it is a KILL SWITCH rather than a phase gate: arming it adds one
# conversations.history read plus one OpenAI call per qualifying channel message, so it changes
# spend on a live workspace. Unset = call volume identical to before GH-55.
# Candidates must be same-channel, within 2 hours, and from the follow-up's author or mention them.
# CHANNEL_ANTECEDENT_LOOKBACK_ENABLED=on
