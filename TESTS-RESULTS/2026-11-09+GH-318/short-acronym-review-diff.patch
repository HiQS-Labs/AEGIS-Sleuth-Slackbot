+
+describe('GH-318 two-letter acronym selection', () => {
+  test.each(['PR', 'ID', 'DB'])('preserves a grounded %s plural in the displayed title', ArgStem => {
+    const Title = `Review ${ArgStem}s`;
+    const Source = `please review the ${ArgStem} tomorrow`;
