diff --git a/tests/reminder-display-selection.test.js b/tests/reminder-display-selection.test.js
index 875ac9b..9d2ff6d 100644
--- a/tests/reminder-display-selection.test.js
+++ b/tests/reminder-display-selection.test.js
@@ -343,3 +343,41 @@ describe('GH-243 long-source safety', () => {
     expect(SelectContextLine({ reminder_message: 'Review the plan', context: Original }, Original, true, Original).text).toBe('');
   });
 });
+
+describe('GH-318 selected wording', () => {
+  const Source = 'I am working on a list of publicly indexable reference URL for you later today';
+  const Candidate = {
+    reminder_message: 'Compile a list of publicly indexable reference URLs',
+    actionable_language: 'I am working on a list of publicly indexable reference URL for you',
+  };
+  test('retains the useful final title rather than repairing or falling back', () => {
+    const Selection = SelectTaskText(Candidate, Source, true, Source);
+    expect(Selection.text).toBe(Candidate.reminder_message);
+    expect(Selection.source).toBe('title');
+    expect(Selection.ungroundedTerms).toEqual([]);
+    expect(Selection.contract.repair).toBeFalsy();
+  });
+  test('an adjacent invented entity is still refused', () => {
+    const Selection = SelectTaskText({ ...Candidate,
+      reminder_message: 'Compile Acme reference URLs',
+    }, Source, true, Source);
+    expect(Selection.text).not.toContain('Acme');
+    expect(Selection.ungroundedTerms).toContain('Acme');
+  });
+  test('preserves grounded acronym context and refuses invented acronym context', () => {
+    expect(SelectContextLine({ reminder_message: 'Prepare the list', context: 'The reference URLs are publicly indexable' },
+      Source, true, Source)).toEqual({ text: 'The reference URLs are publicly indexable', suppressedBy: null });
+    expect(SelectContextLine({ reminder_message: 'Prepare the list', context: 'The reference APIs are publicly indexable' },
+      Source, true, Source)).toEqual({ text: '', suppressedBy: 'ungrounded' });
+  });
+});
+
+describe('GH-318 quoted acronym display', () => {
+  test.each(['Compile " URLs "', 'Compile “ URLs ”', "Compile ' URLs '", 'Compile ‘ URLs ’'])(
+    'refuses a padded quote instead of displaying it: %s', ArgTitle => {
+      const Source = 'working on a reference URL list';
+      const Selection = SelectTaskText({ reminder_message: ArgTitle }, Source, true, Source);
+      expect(Selection.source).not.toBe('title');
+      expect(Selection.ungroundedTerms).toContain('URLs');
+    });
+});
diff --git a/tests/task-grounding.test.js b/tests/task-grounding.test.js
index 0a54c3f..49f4035 100644
--- a/tests/task-grounding.test.js
+++ b/tests/task-grounding.test.js
@@ -250,3 +250,36 @@ describe('UngroundedTerms — inflections are not inventions', () => {
     expect(IsTitleGrounded('Deploy Prod', 'deploy prodx tomorrow')).toBe(false);
   });
 });
+
+// GH-318: ordinary imperative and acronym inflection must not erase a useful title.
+describe('GH-318 title wording', () => {
+  test.each([
+    ['Compile the reference list', 'I am working on the reference list'],
+    ['Prepare reference URLs', 'I am working on a reference URL list'],
+    ['Review APIs', 'review the API'],
+  ])('accepts grounded wording: %s', (ArgTitle, ArgSource) => {
+    expect(IsTitleGrounded(ArgTitle, ArgSource)).toBe(true);
+  });
+  test.each([
+    ['Review Compile', 'review the reference list'],
+    ['Acme deployment', 'deployment is tomorrow'],
+    ['Update Teams', 'update the team'],
+    ['Review AWS', 'review aw'],
+    ['Review APIs', 'review documentation'],
+    ['Review URLs', 'review furl'],
+    ['Compile Acme URLs', 'working on a reference URL list'],
+    ['Compile 23 URLs', 'working on a reference URL list'],
+    ['Compile URLs Monday', 'working on a reference URL list'],
+    ['Compile "URLs"', 'working on a reference URL list'],
+  ])('still rejects invented entities: %s', (ArgTitle, ArgSource) => {
+    expect(IsTitleGrounded(ArgTitle, ArgSource)).toBe(false);
+  });
+});
+
+describe('GH-318 quoted acronym padding', () => {
+  test.each(['Compile " URLs "', 'Compile “ URLs ”', "Compile ' URLs '", 'Compile ‘ URLs ’'])(
+    'keeps quote provenance after trimming: %s', ArgTitle => {
+      expect(UngroundedTerms(ArgTitle, 'reference URL list')).toEqual(['URLs']);
+      expect(IsTitleGrounded(ArgTitle, 'reference URLs list')).toBe(true);
+    });
+});
